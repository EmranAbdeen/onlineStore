@model IEnumerable<onlineStore.Models.Product>
@{
    ViewData["Title"] = "All Products";
    var isAdmin = (Context.Session.GetString("Role") == "Admin");
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 wow fadeIn" data-wow-delay="0.2s">
    <div>
        <h2 class="fw-bold mb-1"><i class="fas fa-boxes text-primary me-2"></i> All Store Products</h2>
        <p class="text-muted mb-0">Browse through our complete catalog of electronics and gadgets</p>
    </div>
    <div class="col-lg-6 text-lg-end text-start">
        <ul class="nav nav-pills d-inline-flex text-center mb-0">
            <li class="nav-item me-2">
                <a class="d-flex py-2 px-4 bg-light rounded-pill active" data-bs-toggle="pill" href="#tab-1">
                    <span class="text-dark fw-bold">All Products</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="d-flex py-2 px-4 bg-light rounded-pill" data-bs-toggle="pill" href="#tab-2">
                    <span class="text-dark fw-bold">New Arrivals</span>
                </a>
            </li>
        </ul>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
            <i class="fas fa-plus-circle me-2"></i> Add New Product
        </a>
    }
</div>
<div class="tab-content">
    <!-- Tab 1: All Products -->
    <div id="tab-1" class="tab-pane fade show p-0 active">
        @if (Model != null && Model.Any())
        {
            <div class="row g-4 wow fadeIn" data-wow-delay="0.2s">
                @foreach (var product in Model)
                {
                    var imgPath = !string.IsNullOrEmpty(product.ImageUrl) ? product.ImageUrl : Url.Content("~/assets/img/product-1.png");
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden product-card hover-lift transition">
                            <div class="position-relative bg-light text-center p-3">
                                <img src="@imgPath" class="card-img-top img-fluid" alt="@product.Name"
                                     style="height: 200px; object-fit: contain;">
                                <span class="badge bg-primary position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                    @(product.Category?.Name ?? "General")
                                </span>
                            </div>

                            <div class="card-body d-flex flex-direction-column flex-column justify-content-between p-4">
                                <div>
                                    <h5 class="card-title fw-bold mb-2 text-truncate" title="@product.Name">@product.Name</h5>
                                    <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px;">
                                        @(string.IsNullOrEmpty(product.Description) ? "No description available." : product.Description)
                                    </p>
                                </div>

                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="fs-4 fw-bold text-primary">$@product.Price.ToString("F2")</span>
                                        <div class="text-warning small">
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star-half-alt"></i>
                                        </div>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <div class="d-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary w-50 rounded-pill py-2">
                                                <i class="fas fa-eye me-1"></i> Details
                                            </a>
                                            <a asp-controller="Cart" asp-action="Add" asp-route-productId="@product.Id" class="btn btn-primary w-50 rounded-pill py-2 shadow-sm">
                                                <i class="fas fa-cart-plus me-1"></i> Cart
                                            </a>
                                        </div>

                                        @if (isAdmin)
                                        {
                                            <a asp-action="Delete" asp-route-id="@product.Id"
                                               class="btn btn-outline-danger btn-sm rounded-pill py-1 mt-1"
                                               onclick="return confirm('Are you sure you want to delete this product: @product.Name?');">
                                                <i class="fas fa-trash-alt me-1"></i> Delete Product
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="card border-0 shadow-sm rounded-4 p-5 bg-light">
                    <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                    <h3 class="fw-bold">No Products In Store</h3>
                    <p class="text-muted">There are currently no products available to display.</p>
                    @if (isAdmin)
                    {
                        <div class="mt-3">
                            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                                <i class="fas fa-plus-circle me-1"></i> Add the First Product
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    <!-- Tab 2: New Arrivals -->
    <div id="tab-2" class="tab-pane fade show p-0">
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var product in Model.OrderByDescending(p => p.Id).Take(8))
                {
                    var imgPath = !string.IsNullOrEmpty(product.ImageUrl) ? product.ImageUrl : Url.Content("~/assets/img/product-1.png");
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden product-card hover-lift transition">
                            <div class="position-relative bg-light text-center p-3">
                                <img src="@imgPath" class="card-img-top img-fluid" alt="@product.Name"
                                     style="height: 200px; object-fit: contain;">
                                <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                    New Arrival
                                </span>
                            </div>

                            <div class="card-body d-flex flex-column justify-content-between p-4">
                                <div>
                                    <h5 class="card-title fw-bold mb-2 text-truncate" title="@product.Name">@product.Name</h5>
                                    <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px;">
                                        @(string.IsNullOrEmpty(product.Description) ? "No description available." : product.Description)
                                    </p>
                                </div>

                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="fs-4 fw-bold text-primary">$@product.Price.ToString("F2")</span>
                                        <div class="text-warning small">
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star-half-alt"></i>
                                        </div>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary w-50 rounded-pill py-2">
                                                <i class="fas fa-eye me-1"></i> Details
                                            </a>
                                            <a asp-controller="Cart" asp-action="Add" asp-route-productId="@product.Id" class="btn btn-primary w-50 rounded-pill py-2 shadow-sm">
                                                <i class="fas fa-cart-plus me-1"></i> Cart
                                            </a>
                                        </div>

                                        @if (isAdmin)
                                        {
                                            <a asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id"
                                               class="btn btn-outline-danger btn-sm rounded-pill py-1 mt-1"
                                               onclick="return confirm('Are you sure you want to delete this product: @product.Name?');">
                                                <i class="fas fa-trash-alt me-1"></i> Delete Product
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
