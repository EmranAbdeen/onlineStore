@model onlineStore.Models.Product

@{
    ViewData["Title"] = Model.Name + " - Details";
    var imgPath = !string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : Url.Content("~/assets/img/product-1.png");
    var isAdmin = (Context.Session.GetString("Role") == "Admin");
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5 text-center">
                <div class="bg-light p-4 rounded-4 border">
                    <img src="@imgPath" class="img-fluid" alt="@Model.Name" style="max-height: 380px; object-fit: contain;">
                </div>
            </div>

            <div class="col-lg-7">
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3">
                    <i class="fas fa-tag me-1"></i> @(Model.Category?.Name ?? "General")
                </span>

                <h1 class="fw-bold mb-2">@Model.Name</h1>

                <div class="d-flex align-items-center mb-3 text-warning">
                    <div class="me-2">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt"></i>
                    </div>
                    <span class="text-muted small">(4.5 Customer Rating)</span>
                </div>

                <div class="mb-4">
                    <span class="display-6 fw-bold text-primary">$@Model.Price.ToString("F2")</span>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-dark">Description:</h6>
                    <p class="text-muted leading-relaxed">
                        @(string.IsNullOrEmpty(Model.Description) ? "No detailed description available for this item." : Model.Description)
                    </p>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-3 flex-wrap align-items-center">
                    <a asp-controller="Cart" asp-action="Add" asp-route-productId="@Model.Id"
                       class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                        <i class="fas fa-shopping-cart me-2"></i> Add to Cart
                    </a>

                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                        <i class="fas fa-arrow-left me-1"></i> Back to Products
                    </a>

                    @if (isAdmin)
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id"
                           class="btn btn-outline-danger btn-lg rounded-pill px-4 ms-auto"
                           onclick="return confirm('Are you sure you want to delete this product: @Model.Name?');">
                            <i class="fas fa-trash-alt me-1"></i> Delete Product
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>