@model IEnumerable<onlineStore.Models.Category>

@{
    ViewData["Title"] = "Categories Management";
}

<div class="card shadow border-0 rounded-4 my-4">
    <div class="card-header bg-dark text-white p-4 rounded-top-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h3 class="mb-1 text-white"><i class="fas fa-tags text-primary me-2"></i> Categories</h3>
            <p class="text-muted small mb-0">Organize and manage store product categories</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Add New Category
        </a>
    </div>

    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Category Name</th>
                            <th>Linked Products</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">
                                    #@category.Id
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="btn-sm-square bg-light text-primary border rounded-circle me-3 d-flex align-items-center justify-content-center">
                                            <i class="fas fa-folder"></i>
                                        </div>
                                        <span class="fw-bold fs-6">@category.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary rounded-pill px-3 py-2">
                                        <i class="fas fa-box me-1"></i> @category.Products.Count Products
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-2">
                                        <i class="fas fa-check-circle me-1"></i> Active
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Delete" asp-route-id="@category.Id"
                                       class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm"
                                       title="Delete category"
                                       onclick="return confirm('Are you sure you want to delete category: @category.Name? All linked products will also be deleted.');">
                                        <i class="fas fa-trash me-1"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                <h5>No categories found</h5>
                <p class="text-muted">Create your first category to start organizing products.</p>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                    <i class="fas fa-plus me-1"></i> Add Category
                </a>
            </div>
        }
    </div>
</div>