@model onlineStore.Models.Cart

@{
    ViewData["Title"] = "My Shopping Cart";
    var total = (Model?.CartItems != null && Model.CartItems.Any())
        ? Model.CartItems.Sum(x => x.Product.Price * x.Quantity)
        : 0m;
}

<div class="card shadow-sm border-0 rounded-4 my-4">
    <div class="card-header bg-dark text-white p-4 rounded-top-4 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1 text-white"><i class="fas fa-shopping-cart text-primary me-2"></i> Shopping Cart</h3>
            <p class="text-muted small mb-0">Review items in your cart and proceed to checkout</p>
        </div>
        @if (Model != null && Model.CartItems.Any())
        {
            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">@Model.CartItems.Sum(i => i.Quantity) Items</span>
        }
    </div>

    <div class="card-body p-4 p-lg-5">
        @if (Model == null || !Model.CartItems.Any())
        {
            <div class="text-center py-5">
                <div class="btn-lg-square bg-light text-muted rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="fas fa-shopping-basket fa-2x"></i>
                </div>
                <h4 class="fw-bold">Your cart is currently empty!</h4>
                <p class="text-muted">Looks like you haven't added any products to your cart yet.</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-3 mt-2 shadow-sm">
                    <i class="fas fa-box-open me-2"></i> Start Shopping Now
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    var imgPath = !string.IsNullOrEmpty(item.Product.ImageUrl) ? item.Product.ImageUrl : Url.Content("~/assets/img/product-1.png");
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@imgPath" class="rounded border p-1 me-3" style="width: 65px; height: 65px; object-fit: contain;" alt="@item.Product.Name" />
                                                <div>
                                                    <h6 class="mb-1 fw-bold">@item.Product.Name</h6>
                                                    <small class="text-muted">Category: @(item.Product.Category?.Name ?? "General")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @* F2: show 2 numbers after the decimal point. *@
                                            <span class="fw-semibold">$@item.Product.Price.ToString("F2")</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <a asp-action="Decrease" asp-route-itemId="@item.Id"
                                                   class="btn btn-sm btn-outline-secondary rounded-circle"
                                                   title="Decrease">
                                                    <i class="fas fa-minus"></i>
                                                </a>
                                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                                    <input type="hidden" name="itemId" value="@item.Id" />
                                                    <input type="number" name="quantity" value="@item.Quantity" min="1"
                                                           class="form-control form-control-sm text-center"
                                                           style="width: 70px;"
                                                           onchange="this.form.submit()" />
                                                </form>
                                                <a asp-action="Increase" asp-route-itemId="@item.Id"
                                                   class="btn btn-sm btn-outline-secondary rounded-circle"
                                                   title="Increase">
                                                    <i class="fas fa-plus"></i>
                                                </a>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-bold text-primary fs-6">
                                                $@((item.Product.Price * item.Quantity).ToString("F2"))
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Remove" asp-route-itemId="@item.Id"
                                               class="btn btn-sm btn-outline-danger rounded-circle"
                                               title="Remove item"
                                               onclick="return confirm('Remove this product from the cart?');">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="fas fa-arrow-left me-1"></i> Continue Shopping
                        </a>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border bg-light rounded-4 p-4 shadow-sm">
                        <h5 class="fw-bold mb-4">Order Summary</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal:</span>
                            <span class="fw-bold">$@total.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Shipping:</span>
                            <span class="text-success fw-bold">FREE</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-bold">Total:</span>
                            <span class="fs-3 fw-bold text-primary">$@total.ToString("F2")</span>
                        </div>
                        <a asp-action="Index" class="btn btn-primary rounded-pill py-3 w-100 shadow fw-bold">
                            <i class="fas fa-credit-card me-2"></i> Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>