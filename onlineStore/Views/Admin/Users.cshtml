@model IEnumerable<onlineStore.Models.User>

@{
    ViewData["Title"] = "Users Management";
    var currentUserId = Context.Session.GetInt32("UserId");
}

<div class="card shadow border-0 rounded-4 my-4">
    <div class="card-header bg-dark text-white p-4 rounded-top-4 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1 text-white"><i class="fas fa-users-cog text-primary me-2"></i> Manage Users</h3>
            <p class="text-muted small mb-0">Approve new registrations or manage user access permissions</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">Total: @Model.Count() Users</span>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Approval Status</th>
                        <th>Account Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isCurrentUser = (user.Id == currentUserId);
                        <tr class="@(isCurrentUser ? "table-light" : "")">
                            <td class="ps-4 fw-bold text-muted">
                                #@user.Id
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="btn-sm-square bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center fw-bold">
                                        @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold">@user.FullName</div>
                                        @if (isCurrentUser)
                                        {
                                            <span class="badge bg-info text-white small">Current Logged-in Admin</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted">@user.Email</span>
                            </td>
                            <td>
                                @if (user.Role?.Name == "Admin")
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2"><i class="fas fa-crown me-1"></i> Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="fas fa-user me-1"></i> User</span>
                                }
                            </td>
                            <td>
                                @if (user.IsApproved)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-2">
                                        <i class="fas fa-check-circle me-1"></i> Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-3 py-2">
                                        <i class="fas fa-clock me-1"></i> Pending Approval
                                    </span>
                                }
                            </td>
                            <td>
                                @if (user.IsBlocked)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="fas fa-ban me-1"></i> Blocked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        <i class="fas fa-shield-alt me-1"></i> Active
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (isCurrentUser)
                                {
                                    <span class="badge bg-light text-muted border px-3 py-2" title="You cannot block your own account">
                                        <i class="fas fa-lock me-1"></i> Protected (You)
                                    </span>
                                }
                                else
                                {
                                    <div class="btn-group" role="group">
                                        @if (!user.IsApproved)
                                        {
                                            <a asp-action="Approve" asp-route-id="@user.Id"
                                               class="btn btn-success btn-sm rounded-pill px-3 me-1 shadow-sm">
                                                <i class="fas fa-check me-1"></i> Approve
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Unapprove" asp-route-id="@user.Id"
                                               class="btn btn-outline-warning btn-sm rounded-pill px-3 me-1 shadow-sm"
                                               onclick="return confirm('Revoke approval for this user: @user.FullName? They will not be able to log in until approved again.');">
                                                <i class="fas fa-undo me-1"></i> Unapprove
                                            </a>
                                        }

                                        @if (!user.IsBlocked)
                                        {
                                            <a asp-action="Block" asp-route-id="@user.Id"
                                               class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm"
                                               onclick="return confirm('Are you sure you want to BLOCK this user: @user.FullName?');">
                                                <i class="fas fa-ban me-1"></i> Block
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Unblock" asp-route-id="@user.Id"
                                               class="btn btn-warning btn-sm rounded-pill px-3 shadow-sm">
                                                <i class="fas fa-unlock me-1"></i> Unblock
                                            </a>
                                        }
                                        <a asp-action="Delete" asp-route-id="@user.Id"
                                           class="btn btn-outline-danger btn-sm rounded-pill px-3 ms-1 shadow-sm"
                                           title="Delete user"
                                           onclick="return confirm('Are you sure you want to permanently delete user: @user.FullName? This cannot be undone.');">
                                            <i class="fas fa-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>